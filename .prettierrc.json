{
  "tabWidth": 4,
  "useTabs": false,
  "singleQuote": true,
  "printWidth": 120,
  "semi": true,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.yml", "*.yaml", "*.json", "*.jsonc"],
      "options": { "tabWidth": 2 }
    }
  ]
}
