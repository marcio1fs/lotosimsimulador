# ======================================================================
# LOTOMAIS - VARIAVEIS DE AMBIENTE (apenas SERVIDOR)
# ======================================================================
# NUNCA use o prefixo VITE_ para segredos: variaveis VITE_* vao para o navegador.
# Copie para .env (local) e configure o mesmo valor no painel da hospedagem (Vercel > Settings > Environment Variables).
# URL de conexao do Neon (https://console.neon.tech). Use uma senha NOVA, nao a que ja vazou.
DATABASE_URL=postgresql://SEU_USUARIO:SUA_SENHA@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# --- Opcional: origens extras aceitas em requisicoes de mutacao (CSRF) ---
# Por padrao o servidor so aceita a propria origem (Host / X-Forwarded-Host).
# Use quando o site for servido de um dominio diferente do que chama a API
# (ex.: dominio de preview da Vercel). Lista separada por virgula, com esquema.
# ALLOWED_ORIGINS=https://lotomais.vercel.app,https://preview-lotomais.vercel.app

# --- Recuperacao de conta (redefinicao de senha + verificacao de e-mail) ---
# Sem estas variaveis, as rotas de recuperacao respondem 503 e o cadastro avisa
# que o e-mail nao saiu. O cadastro em si continua funcionando.
# Chave do provedor de e-mail (o transporte usa a API HTTP do Resend, sem SDK).
# EMAIL_API_KEY=re_sua_chave_aqui
# Remetente precisa ser de um dominio verificado no provedor.
# EMAIL_FROM=nao-responda@seudominio.com
# Base publica usada nos links do e-mail (fallback: Host da requisicao).
# APP_BASE_URL=https://seudominio.com
# APENAS desenvolvimento: imprime o e-mail no log em vez de enviar.
# Recusado quando NODE_ENV=production, porque o log teria o token.
# EMAIL_TRANSPORT=console
