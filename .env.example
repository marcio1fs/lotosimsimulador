# ======================================================================
# LOTOMAIS - VARIAVEIS DE AMBIENTE (apenas SERVIDOR)
# ======================================================================
# NUNCA use o prefixo VITE_ para segredos: variaveis VITE_* vao para o navegador.
# Copie para .env (local) e configure o mesmo valor no painel da hospedagem (Vercel > Settings > Environment Variables).
# URL de conexao do Neon (https://console.neon.tech). Use uma senha NOVA, nao a que ja vazou.
DATABASE_URL=postgresql://SEU_USUARIO:SUA_SENHA@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
