{
  "name": "lotosimsimulador",
  "version": "1.1.0",
  "description": "Inteligência Artificial, Pesquisa Operacional e Teoria dos Jogos para Loterias",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "index.html",
  "scripts": {
    "dev": "node scripts/build-html.mjs && vite --host",
    "build": "node scripts/build-html.mjs && vite build",
    "build:html": "node scripts/build-html.mjs",
    "check:html": "node scripts/build-html.mjs --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "calibrar": "node scripts/antiCrowdCalibration.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "build:schema": "node scripts/build-schema.mjs",
    "check:schema": "node scripts/build-schema.mjs --check",
    "build:manifest": "node scripts/build-migrations-manifest.mjs",
    "check:manifest": "node scripts/build-migrations-manifest.mjs --check"
  },
  "keywords": [
    "lottery",
    "statistics",
    "wheeling",
    "markov-chains",
    "game-theory",
    "simulated-annealing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
